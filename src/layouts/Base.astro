---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import Band from '../components/Band.astro';
import NavList, { type NavItem } from '../components/NavList.astro';
import logo from '../assets/moebiuslogo5001503.png';
import badge from '../assets/moebiuslogo.png';
import footerPhoto from '../assets/freestyleskiingmoebius.jpg';
import defaultShare from '../assets/moebiusfreestyle1980x720px.jpg';

interface Props {
  title: string;
  lang?: string;
  description?: string;
  image?: ImageMetadata;
  slug: string;
  hero?: {
    image: ImageMetadata;
    heading: string;
    cta?: { label: string; href: string };
  };
}

const {
  title,
  lang = 'fi',
  description = 'Freestyleseura Moebius ry on vuonna 1980 perustettu pääkaupunkiseudulla toimiva freestyleseura.',
  slug,
  hero,
  image,
} = Astro.props;

// The SkiTour dropdown: the coming season (skitour.mdx, labelled with its
// first "# SkiTour YYYY" heading) and then the past seasons (skitour-YYYY.mdx),
// newest first. A new season page appears there automatically.
const currentSeason = (await getEntry('pages', 'skitour'))?.body?.match(/^# (SkiTour \d{4})/m)?.[1] ?? 'SkiTour';
const pastSeasons = (await getCollection('pages', (p) => /^skitour-\d{4}$/.test(p.id)))
  .map((p) => p.id)
  .sort()
  .reverse()
  .map((id) => ({ label: `SkiTour ${id.slice(-4)}`, path: id }));
const seasons = [{ label: currentSeason, path: 'skitour' }, ...pastSeasons];

const nav: NavItem[] = [
  { label: 'Etusivu', path: '' },
  { label: 'Ajankohtaista', path: 'ajankohtaista' },
  { label: 'SkiTour', path: 'skitour', children: seasons },
  { label: 'Jäsenyys', path: 'jasenyys' },
  { label: 'Harraste', path: 'harraste' },
  { label: 'Kuvagalleria', path: 'kuvagalleria' },
  { label: 'Yhteystiedot', path: 'yhteystiedot' },
  { label: 'In English', path: 'in-english' },
  { label: 'På Svenska', path: 'pa-svenska' },
];

// Menu button and drawer labels in the page's language.
const allMenuLabels = {
  fi: { menu: 'Valikko', nav: 'Päävalikko', close: 'Sulje valikko', back: 'Takaisin', open: 'avaa alavalikko' },
  en: { menu: 'Menu', nav: 'Main menu', close: 'Close menu', back: 'Back', open: 'open submenu' },
  sv: { menu: 'Meny', nav: 'Huvudmeny', close: 'Stäng menyn', back: 'Tillbaka', open: 'öppna undermeny' },
};
const menuLabels = allMenuLabels[lang as keyof typeof allMenuLabels] ?? allMenuLabels.fi;

// Square icons from the shield badge; the wide header logo is squashed in a tab.
const favicon = await getImage({ src: badge, width: 64, height: 64, format: 'png' });
const touchIcon = await getImage({ src: badge, width: 180, height: 180, format: 'png' });
const footerBg = await getImage({ src: footerPhoto, width: 1600, format: 'webp' });
// Link previews (Facebook, Instagram, WhatsApp, ...) need absolute URLs.
const shareImage = await getImage({ src: image ?? hero?.image ?? defaultShare, width: 1200, format: 'jpg' });
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const shareUrl = new URL(shareImage.src, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" sizes="64x64" href={favicon.src} />
    <link rel="apple-touch-icon" sizes="180x180" href={touchIcon.src} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Freestyleseura Moebius ry" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl.href} />
    <meta property="og:image" content={shareUrl.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <header class="site-header">
      <a class="logo" href="/"><Image src={logo} alt="Moebius Freestyle" height={112} /></a>
      <nav class="site-nav" aria-label={menuLabels.nav}>
        <NavList items={nav} slug={slug} variant="bar" />
      </nav>
      <button class="menu-button" type="button" popovertarget="drawer-nav">
        <span class="burger" aria-hidden="true"></span>{menuLabels.menu}
      </button>
      <nav id="drawer-nav" class="drawer" popover aria-label={menuLabels.nav}>
        <div class="drawer-head">
          <span class="drawer-title">{menuLabels.menu}</span>
          <button class="drawer-close" type="button" popovertarget="drawer-nav" popovertargetaction="hide" aria-label={menuLabels.close}>
            <span aria-hidden="true">×</span>
          </button>
        </div>
        <NavList items={nav} slug={slug} variant="drawer" navId="drawer-nav" labels={menuLabels} />
      </nav>
    </header>

    <main>
      {hero && <Band image={hero.image} heading={hero.heading} cta={hero.cta} level={1} />}
      <slot />
    </main>

    <footer class="site-footer" style={`background-image:url(${footerBg.src})`}>
      <div class="footer-inner">
        <Image class="footer-badge" src={badge} alt="Moebius Freestyle Finland" width={440} />
        <div>
          <h3>Freestyleseura Moebius ry</h3>
          <p>
            <strong>Toiminnanjohtaja</strong><br />
            Alex Holmbom<br />
            <a href="mailto:info@moebius.fi">info@moebius.fi</a><br />
            +358 44 976 0295
          </p>
          <p><a href="/tietosuojalupaus/">Tietosuoja</a></p>
        </div>
        <div>
          <p>Freestyleseura Moebius ry on vuonna 1980 perustettu pääkaupunkiseudulla toimiva, perinteikäs freestyleseura.</p>
          <h3>Seuraa meitä somessa!</h3>
          <p>
            <a href="https://www.facebook.com/moebiusfreestyle">Facebook</a><br />
            <a href="https://www.instagram.com/moebiusfreestyle/">Instagram</a><br />
            <a href="https://www.youtube.com/@MoebiusFreestyle">YouTube</a>
          </p>
        </div>
      </div>
      <div class="footer-bottom">
        <span>© Freestyleseura Moebius ry</span>
      </div>
    </footer>
  </body>
</html>
